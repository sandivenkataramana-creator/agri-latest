                "key": "X-Api-Key",
                "value": "{{api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"EMP001\",\n  \"attendance_date\": \"2024-02-15\",\n  \"check_in\": \"09:00:00\",\n  \"check_out\": \"17:30:00\",\n  \"status\": \"present\",\n  \"remarks\": \"Regular working day\",\n  \"device_id\": \"DEVICE_001\"\n}"
            },
