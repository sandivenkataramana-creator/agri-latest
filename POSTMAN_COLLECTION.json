{
  "info": {
    "name": "AGRI Attendance API Integration",
    "description": "Complete API collection for AGRI Management System Attendance Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-domain.com/api/attendance-import",
      "type": "string"
    },
    {
